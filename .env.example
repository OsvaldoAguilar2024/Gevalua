# Copia este archivo a .env para trabajar en local. Nunca subas .env al repositorio.
DEBUG=1
SECRET_KEY=cambia-esto
DATABASE_URL=postgres://postgres@127.0.0.1:5432/gevalua

# Cada empresa entra por <subdominio>.BASE_DOMAIN
BASE_DOMAIN=oatech.com.co
# Dominios del panel del operador (separados por coma). En Railway se suma solo RAILWAY_PUBLIC_DOMAIN.
PUBLIC_DOMAINS=gevalua.oatech.com.co

# Correo (Resend). Sin clave, los correos salen por la consola.
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=gevalua <no-responder@oatech.com.co>

# Railway Storage Bucket (API S3). Sin bucket, los archivos van al disco local.
AWS_S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=
AWS_DEFAULT_REGION=auto
